msgstr "Contribuye a una base de datos global de patrones de luz nocturna"

#: frontend/templates/index.html:800
msgid "Support Research"
msgstr "Apoyar la investigación"

#: frontend/templates/index.html:801
msgid "Enable scientific studies on light pollution's environmental impact"
msgstr ""
"Permite estudios científicos sobre el impacto ambiental de la contaminación "
"lumínica"

